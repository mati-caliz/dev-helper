{
  "manifest_version": 3,
  "name": "LocalStorage, Cookies & Scripts Manager",
  "version": "1.2",
  "description": "Manage localStorage, cookies, userscripts and device simulation from popup.",
  "permissions": ["storage", "tabs", "cookies", "scripting", "webNavigation", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "src/index.html",
    "default_icon": {
      "16": "icons/icon.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}